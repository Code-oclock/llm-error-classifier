# Model pulled by Ollama and used by the classifier (any Ollama tag).
LLM_MODEL=granite4.2:3b
# CPU and RAM limits of the Ollama container (the measurements in the README use 4 and 8g).
OLLAMA_CPUS=4
OLLAMA_MEMORY=8g
# Parallel requests inside Ollama; each one holds its own KV cache in RAM.
OLLAMA_NUM_PARALLEL=1
# Simultaneous classify calls the service lets in (keep equal to OLLAMA_NUM_PARALLEL); the rest wait QUEUE_WAIT, then get 429.
MAX_CONCURRENT=1
# Per-request timeout towards the model.
LLM_TIMEOUT=120s
# Language of summary and suggested_action.
CLASSIFY_LANGUAGE=English
# Host ports (all bound to 127.0.0.1).
CLASSIFIER_PORT=8080
OLLAMA_PORT=11434
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
# Grafana admin password (observability profile).
GRAFANA_ADMIN_PASSWORD=admin
# Proxy for the image build and for model downloads, only if the host needs one.
BUILD_PROXY=
HTTPS_PROXY=
HTTP_PROXY=
